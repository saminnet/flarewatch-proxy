# Copy to `docker/.env` and edit.

PORT=3000

# The host address Docker publishes the port on: 127.0.0.1 for this machine only, 0.0.0.0 for
# your network.
BIND_ADDRESS=127.0.0.1

# Required: the same value as the FLAREWATCH_PROXY_TOKEN secret in your FlareWatch fork.
# Generate with: `openssl rand -base64 32`
FLAREWATCH_PROXY_TOKEN=

# Optional: the old token, accepted too while you change the token.
# FLAREWATCH_PROXY_TOKEN_PREVIOUS=

# Optional: the location FlareWatch records for checks run here. Unset, the proxy asks Cloudflare.
# FLAREWATCH_PROXY_LOCATION="Berlin office"

# Optional: the token of a Cloudflare Tunnel, for `docker compose --profile tunnel up`.
# TUNNEL_TOKEN=
