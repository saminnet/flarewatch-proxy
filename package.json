{
  "name": "@flarewatch/proxy",
  "version": "1.1.0",
  "private": true,
  "description": "Self-hostable proxy for FlareWatch uptime monitoring",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "compile": "vp check --no-fmt --no-lint",
    "dev": "tsx watch src/index.ts",
    "docker:build": "docker build -t flarewatch-proxy -f docker/Dockerfile .",
    "docker:run": "docker run -p 127.0.0.1:3000:3000 flarewatch-proxy",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "lint": "vp lint",
    "start": "node dist/index.mjs",
    "start:dev": "tsx src/index.ts",
    "test": "vp test run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "undici": "^7.30.0",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.1.0"
}
